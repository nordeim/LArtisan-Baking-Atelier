# ============================================
# L'Artisan Baking Atelier - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git

# ============================================
# DATABASE
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Docker: postgresql://artisan:your_password@localhost:5432/artisan_atelier?schema=public
DATABASE_URL="postgresql://artisan:secure_password@localhost:5432/artisan_atelier?schema=public"

# Direct connection for migrations (bypasses connection pooler if using PgBouncer)
DIRECT_URL="postgresql://artisan:secure_password@localhost:5432/artisan_atelier?schema=public"

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Generate a secure random string with:
#   openssl rand -base64 32
# OR
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="your-256-bit-secret-minimum-32-characters-long-change-in-production"

# Application URL for callbacks and links
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# REDIS (Rate Limiting & Session Caching)
# ============================================
# For Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ============================================
# STRIPE PAYMENTS
# ============================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Publishable key (safe for client-side)
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Secret key (server-side only)
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"

# Webhook secret (get this from Stripe CLI or Dashboard)
# For local development, use Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ============================================
# APPLICATION SETTINGS
# ============================================
# Node environment: development | production | test
NODE_ENV="development"

# Port for the application (optional, defaults to 3000)
PORT="3000"

# ============================================
# OPTIONAL: EMAIL SERVICE
# ============================================
# For order confirmations and notifications
# EMAIL_PROVIDER="smtp"
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="587"
# EMAIL_USER=""
# EMAIL_PASSWORD=""
# EMAIL_FROM="noreply@artisan-baking-atelier.com"

# ============================================
# OPTIONAL: OAUTH PROVIDERS
# ============================================
# Google OAuth (for customer login)
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================
# Google Analytics 4
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Sentry for error tracking
# SENTRY_DSN=""

# ============================================
# OPTIONAL: CDN & STORAGE
# ============================================
# Cloudflare R2 or AWS S3 for image uploads
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_BUCKET=""
# STORAGE_REGION=""

# ============================================
# SECURITY SETTINGS
# ============================================
# Enable additional security headers
# SECURITY_HEADERS_ENABLED="true"

# Content Security Policy (add trusted domains)
# CSP_TRUSTED_DOMAINS=""
