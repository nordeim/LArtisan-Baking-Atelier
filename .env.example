# ============================================
# L'Artisan Baking Atelier - Development Environment
# Copy this file to .env.local for local development
# ============================================

# ============================================
# Application
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://artisan:artisan_secure_password@localhost:5432/artisan_atelier?schema=public"
DIRECT_URL="postgresql://artisan:artisan_secure_password@localhost:5432/artisan_atelier?schema=public"

# Database credentials for scripts
DB_HOST=localhost
DB_PORT=5432
DB_USER=artisan
DB_PASSWORD=artisan_secure_password
DB_NAME=artisan_atelier

# ============================================
# Redis (Cache & Sessions)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET="development-secret-do-not-use-in-production-min-32-chars"

# ============================================
# Stripe (TEST KEYS)
# Get from: https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY

# ============================================
# Email (Resend)
# Get from: https://resend.com/api-keys
# ============================================
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=L'Artisan Baking Atelier <noreply@artisan-baking.local>

# ============================================
# Sentry (Optional for local dev)
# ============================================
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# AWS (Optional for local dev)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
BACKUP_S3_BUCKET=

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
