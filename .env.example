# ============================================
# L'Artisan Baking Atelier - Environment Variables
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://lartisan:password@localhost:5432/lartisan_db"

# --------------------------------------------
# Authentication (Jose JWT)
# --------------------------------------------
# Generate a secure random string (min 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# --------------------------------------------
# Stripe Configuration
# --------------------------------------------
# Get your API keys from: https://dashboard.stripe.com/apikeys

# Test Secret Key (starts with sk_test_ for development)
STRIPE_SECRET_KEY="sk_test_..."

# Test Publishable Key (starts with pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook Secret (get from Stripe CLI or dashboard)
# For local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --------------------------------------------
# Application Configuration
# --------------------------------------------
# Application URL (change for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment (development | production)
NODE_ENV="development"

# --------------------------------------------
# Optional: Email Service
# --------------------------------------------
# For order confirmations (configure when ready)
# RESEND_API_KEY="re_..."
# FROM_EMAIL="orders@artisan-baking-atelier.com"

# --------------------------------------------
# Optional: Analytics
# --------------------------------------------
# VERCEL_ANALYTICS_ID=""
