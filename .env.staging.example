# ============================================
# L'Artisan Baking Atelier - Staging Environment
# Copy this file to .env.staging and fill in your values
# DO NOT commit .env.staging to version control
# ============================================

# ============================================
# Application
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.artisan-baking.com
NEXT_PUBLIC_APP_ENV=staging

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://artisan:YOUR_STAGING_PASSWORD@staging-db-host:5432/artisan_atelier_staging?sslmode=require
DIRECT_URL=postgresql://artisan:YOUR_STAGING_PASSWORD@staging-db-host:5432/artisan_atelier_staging?sslmode=require

# Database credentials for backup scripts
DB_HOST=postgres
DB_PORT=5432
DB_USER=artisan
DB_PASSWORD=YOUR_STAGING_PASSWORD
DB_NAME=artisan_atelier_staging

# ============================================
# Redis (Cache & Sessions)
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=YOUR_STAGING_REDIS_PASSWORD

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET=staging-jwt-secret-min-32-characters-different-from-prod

# ============================================
# Stripe (TEST KEYS FOR STAGING)
# ============================================
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=L'Artisan Baking Atelier Staging <staging@artisan-baking.com>

# ============================================
# Sentry (Error Monitoring)
# ============================================
SENTRY_DSN=https://YOUR_STAGING_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=lartisan-baking-atelier-staging

# ============================================
# AWS (for backups)
# ============================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-southeast-1
BACKUP_S3_BUCKET=artisan-baking-backups-staging

# ============================================
# Docker Configuration
# ============================================
DOCKER_TARGET=runner

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
