# ============================================
# L'Artisan Baking Atelier - Local Development Environment
# ============================================

# Database - Using local PostgreSQL
DATABASE_URL="postgresql://artisan:artisan_secure_password@localhost:5432/artisan_atelier?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secret (generate a real one for production)
JWT_SECRET="dev-secret-do-not-use-in-production-change-this-in-production"

# Application
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Stripe (test keys - replace with real ones)
STRIPE_PUBLISHABLE_KEY="pk_test_sample"
STRIPE_SECRET_KEY="sk_test_sample"
STRIPE_WEBHOOK_SECRET="whsec_sample"
